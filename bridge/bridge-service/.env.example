# Copy this file to .env and fill in values for your environment.
# Never commit a real .env file. In production, ETHEREUM_TREASURY_PRIVATE_KEY
# should not exist as a plaintext environment variable at all; see Chapter 8's
# key management section for the HSM-backed signing pattern this should
# actually use.

# --- MultiChain (Meridian Rewards chain), per Listing 6.3 ---
MULTICHAIN_RPC_HOST=localhost
MULTICHAIN_RPC_PORT=8570
MULTICHAIN_RPC_USER=meridian
MULTICHAIN_RPC_PASSWORD=devpassword
MULTICHAIN_CHAIN_NAME=meridian-rewards-dev

# --- Ethereum bridge (Section 10.5) ---
# Local Hardhat node by default; point this at a real testnet or
# mainnet RPC provider for anything beyond local development.
ETHEREUM_RPC_URL=http://127.0.0.1:8545
# DEVELOPMENT ONLY. Replace with HSM-backed signing in production.
ETHEREUM_TREASURY_PRIVATE_KEY=
ETHEREUM_NFT_CONTRACT_ADDRESS=
INITIAL_USD_PER_ETH_RATE=3200

# --- Corda bridge (Section 10.6) ---
# Points at corda-flow-simulator/server.js for local development, or
# at a real CorDapp webserver plugin in production. See
# docs/ARCHITECTURE.md.
CORDA_FACADE_HOST=localhost
CORDA_FACADE_PORT=9200
MERIDIAN_CONSORTIUM_PARTICIPANT_ID=meridian-retail-banking-01

# --- Orchestration ---
BRIDGE_POLL_INTERVAL_MS=5000
